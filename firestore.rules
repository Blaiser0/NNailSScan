rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isDefaultAdminEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'snakercher@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isDefaultAdminEmail()
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin'
      );
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        request.auth.uid == userId
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']))
      );
      allow delete: if false;
    }

    match /scans/{scanId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'userId',
          'result',
          'rawLabel',
          'confidence',
          'imageUrl',
          'dictionaryTermId',
          'createdAt'
        ]);
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /admin_requests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['userId', 'email', 'fullName', 'status', 'createdAt']);
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /dictionary_terms/{termId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/dictionary_terms/$(termId))
        && request.resource.data.keys().hasAll(['id', 'title', 'description', 'imageUrl']);
      allow update, delete: if false;
    }
  }
}
